# Fintrack backend environment template
#
# This file is safe to copy for local development only. Never commit the
# resulting .env file or use the example values in a production deployment.
# For production, select config.settings.base and replace every value marked
# CHANGE_ME/REPLACE_ME from the deployment secret store.

# Runtime/settings selection -------------------------------------------------
# local enables the development defaults (DEBUG and permissive CORS). Use
# config.settings.base in production; it keeps DEBUG off and CORS closed.
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-in-local-env
DJANGO_DEBUG=True

# Comma-separated hostnames accepted by Django. Do not use '*' in production.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Local convenience only. Production must be False and use a same-origin or
# explicitly controlled reverse-proxy arrangement.
DJANGO_CORS_ALLOW_ALL_ORIGINS=True
DJANGO_TIME_ZONE=UTC

# Production override block (set these in the deployment environment; these
# commented lines are intentionally not loaded for local development):
# DJANGO_SETTINGS_MODULE=config.settings.base
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=api.example.com,internal-api.example.com
# DJANGO_CORS_ALLOW_ALL_ORIGINS=False
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# DJANGO_SECURE_HSTS_PRELOAD=True

# Database -------------------------------------------------------------------
# SQLite is the supported local default. Production should use the PostgreSQL
# engine supplied by the chosen platform and a managed database service.
DJANGO_DB_ENGINE=django.db.backends.sqlite3
DJANGO_DB_NAME=db.sqlite3
DJANGO_DB_HOST=
DJANGO_DB_PORT=
DJANGO_DB_USER=
DJANGO_DB_PASSWORD=

# JWT ------------------------------------------------------------------------
# Lifetimes are read by SIMPLE_JWT in config.settings.base. Keep access tokens
# short and rotate refresh tokens; lowering these values reduces exposure.
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=1
# Keep JWT signing material in the deployment secret store; this is separate
# from the Django signing key when operating multiple services.
JWT_SIGNING_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256

# Authentication throttles (Django cache-backed; use a shared cache in a
# multi-instance deployment).
AUTH_LOGIN_RATE=10/minute
AUTH_REGISTER_RATE=5/hour
AUTH_REFRESH_RATE=30/minute
AUTH_PASSWORD_RESET_RATE=5/hour
AUTH_OAUTH_RATE=10/minute
PASSWORD_RESET_TIMEOUT_SECONDS=3600

# Optional AI insights module (core finance features do not depend on it) -----
AI_INSIGHTS_ENABLED=False
AI_INSIGHTS_PROVIDER=placeholder

# Google OIDC (server-side only; never expose the client secret to Vite)
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
GOOGLE_OIDC_REDIRECT_URI=http://127.0.0.1:5173/oauth/google/callback
GOOGLE_OIDC_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration
OAUTH_ATTEMPT_TIMEOUT_SECONDS=300
OIDC_CLOCK_SKEW_SECONDS=60
OAUTH_HTTP_TIMEOUT_SECONDS=5
OAUTH_MAX_RESPONSE_BYTES=1048576
